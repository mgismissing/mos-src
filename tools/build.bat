@nasm -f bin boot.asm -o boot.bin && rmdir /s /q iso && wsl dd if=/dev/zero of=mos.img bs=1024 count=1440 && wsl dd if=boot.bin of=mos.img seek=0 count=64 conv=notrunc && del bin\boot.bin && copy boot.bin bin\boot.bin && del boot.bin && mkdir iso && copy mos.img iso\mos.img && del mos.img && wsl genisoimage -V 'MOS' -input-charset iso8859-1 -o mos.iso -b mos.img -hide mos.img iso && copy mos.iso iso\mos.iso && del mos.iso
