@wsl cc/i386-elf-gcc -ffreestanding -m32 -g -c main.cpp -o main.o && nasm -f elf main_entry.asm -o main_entry.o && wsl cc/i386-elf-ld -o full_main.bin -Ttext 0x1000 main_entry.o main.o --oformat binary && nasm -f bin boot.asm -o boot.bin && wsl cat boot.bin full_main.bin boot.bin && rmdir /s /q iso && wsl dd if=/dev/zero of=mos.img bs=1024 count=1440 && wsl dd if=boot.bin of=mos.img seek=0 count=32 conv=notrunc && del bin\boot.bin && copy boot.bin bin\boot.bin && del boot.bin && mkdir iso && copy mos.img iso\mos.img && del mos.img && wsl genisoimage -V 'MOS' -input-charset iso8859-1 -o mos.iso -b mos.img -hide mos.img iso && copy mos.iso iso\mos.iso && del mos.iso
